// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Store {
  id            String   @id @default(cuid())
  storeDomain   String   @unique // e.g. brand-a.myshopify.com
  planTier      String   @default("free") // free, basic, max
  billingMethod String   @default("shopify") // shopify, invoice, none
  isLegacy      Boolean  @default(false)
  legacyPrice   Int? // cents, for internal records
  currencyCode  String? // ISO 4217, e.g. "INR" / "USD" — synced from Shopify shop settings
  ianaTimezone  String? // e.g. "Asia/Kolkata" — synced from Shopify, used for day bucketing
  notes         String?
  onboarding    String   @default("{\"completed\":false,\"steps\":{\"offer_created\":false,\"settings_configured\":false,\"previewed\":false}}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([storeDomain])
}

// Internal team members who can sign into the standalone /enterprise dashboard
// (email + password, separate from Shopify admin auth).
model AdminUser {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String?
  failedAttempts Int       @default(0) // consecutive failed logins (reset on success)
  lockedUntil    DateTime? // set after too many failures; login blocked until then
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([email])
}

// Audit trail for /enterprise admin actions (price changes, reverts, deletes…).
model AuditLog {
  id          String   @id @default(cuid())
  actorEmail  String // which admin performed it
  action      String // set_enterprise_price | revert_enterprise | delete_store | reset_onboarding
  storeDomain String?
  detail      String? // human-readable summary, e.g. "$0 → $200/mo"
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([storeDomain])
}

model ThemeConfig {
  id        String   @id @default(cuid())
  shopId    String
  themeId   String
  config    String   @default("{}") // JSON blob — milestones, freebies, upsells, drawer settings
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, themeId])
  @@index([shopId])
}

model AnalyticsEvent {
  id            String   @id @default(cuid())
  shopId        String
  event         String
  source        String   // drawer | web_pixel | server
  promotionId   String?
  promotionType String?  // offer | coupon | claim-gift | upsell
  promotionName String?  // snapshot of the promotion's display name at write time
  customerId    String?
  sessionId     String?
  cartTotal     Int?
  itemCount     Int?
  revenue       Int?
  metadata      Json?
  occurredAt    DateTime
  createdAt     DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([shopId, promotionId, createdAt])
  @@index([shopId, event, createdAt])
}

model DailyStats {
  id            String   @id @default(cuid())
  shopId        String
  date          String   // YYYY-MM-DD, shop-local
  promotionId   String
  promotionName String?  // snapshot of the promotion's display name (durable label; survives config deletion)
  promotionType String?  // offer | coupon | claim-gift | upsell (snapshot; survives config deletion)
  impressions   Int      @default(0)
  claims        Int      @default(0)
  removals      Int      @default(0)
  upsellAdds    Int      @default(0)
  couponApplies Int      @default(0)
  checkouts     Int      @default(0)
  orders        Int      @default(0)
  revenue       Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([shopId, date, promotionId])
  @@index([shopId, date])
}
