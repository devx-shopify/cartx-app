{% comment %}
  cartx — App Embed Block
  Auto-injected on every page when enabled in theme editor.
  Mounts the Preact cart drawer and installs fetch interception.
{% endcomment %}

{% comment %}
  Critical CSS — inline so native cart drawers are hidden at FIRST PAINT,
  before the async cartmax.css <link> applies. Without this the host theme's
  drawer flashes on click until the stylesheet loads. Keep these selectors in
  sync with the matching block in assets/cartmax.css.
{% endcomment %}
{%- comment -%} Drawer-less plans (Basic) don't include the cart drawer. Suppress
  the ENTIRE block — interception script AND bundle — so enabling this embed on
  Basic does nothing. Fail-open: hides only when the plan metafield is exactly
  "basic"; absent / Pro / Enterprise always render (protects live drawer stores). {%- endcomment -%}
{%- unless shop.metafields['$app'].plan.value == 'basic' -%}
<style>
  #cartmax-root { display: block !important; }
  cart-drawer,
  .cart-drawer:not(cart-drawer-component),
  #cart-drawer:not(cart-drawer-component),
  cart-notification,
  .cart-notification,
  dialog[is="cart-drawer"],
  dialog#cart-drawer,
  .cart-drawer-container,
  cart-drawer-component > dialog,
  cart-drawer-component aside,
  cart-drawer-component [role="dialog"],
  cart-drawer-component .cart-drawer__dialog,
  cart-drawer-component .cart-drawer__overlay,
  cart-notification-component > dialog,
  cart-notification-component [role="dialog"] {
    display: none !important;
  }
</style>

<div
  id="cartmax-root"
  data-cartmax-enabled="true"
  data-shop-id="{{ shop.permanent_domain }}"
  data-theme-id="{{ theme.id }}"
  data-customer-id="{{ customer.id }}"
  data-customer-tags="{{ customer.tags | json | escape }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-proxy-base="/apps/cartx"
  data-analytics-enabled="true"
  data-initial-item-count="{{ cart.item_count }}"
  data-initial-cart="{{ cart | json | escape }}"
  data-drawer-config="{{ shop.metafields['$app'].drawer_config.value | json | escape }}"
></div>
<script>
  // theme.id may not render in app embed blocks — set it from window.Shopify.theme
  (function() {
    var el = document.getElementById('cartmax-root');
    if (el && !el.dataset.themeId && window.Shopify && window.Shopify.theme) {
      el.dataset.themeId = String(window.Shopify.theme.id);
    }
  })();
</script>

{% comment %}
  Inline interception script — must run BEFORE any theme/third-party JS
  fires ATC calls. This patches fetch + XHR to observe cart API calls.
{% endcomment %}
<script>
  (function() {
    'use strict';

    // ── Early public-API stub ─────────────────────────────────
    // Partner apps integrate by calling window.cartx.addItem(...) (see
    // docs/partner-cart-integration.md). This inline script runs before the
    // drawer bundle mounts, so we expose a stub that BUFFERS calls onto _q and
    // the real CartDrawer flushes them on mount. open/toggle set the existing
    // open-intent flag the click handler below already honors.
    if (!window.cartx) {
      var _cartxQueue = [];
      window.cartx = {
        _q: _cartxQueue,
        _stub: true,
        addItem: function () {
          _cartxQueue.push(['addItem', [].slice.call(arguments)]);
          return Promise.resolve();
        },
        open: function () { window.__cartmaxOpenIntent = true; },
        toggle: function () { window.__cartmaxOpenIntent = true; },
        close: function () {},
        refresh: function () {},
        isOpen: function () { return false; },
      };
    }

    // Match both /cart/add.js AND /cart/add (Dawn uses the non-.js form)
    var CART_PATTERNS = ['/cart/add', '/cart/update', '/cart/change', '/cart/clear'];

    function isCartEndpoint(url) {
      try {
        var path = new URL(url, window.location.origin).pathname;
        return CART_PATTERNS.some(function(ep) {
          return path === ep || path === ep + '.js';
        });
      } catch(e) {
        return typeof url === 'string' && CART_PATTERNS.some(function(ep) {
          return url.indexOf(ep) !== -1;
        });
      }
    }

    function extractUrl(input) {
      if (typeof input === 'string') return input;
      if (input instanceof Request) return input.url;
      return '';
    }

    // Flag for cartx's own API calls — skip interception for these
    window.__cartmaxInternal = false;

    var originalFetch = window.fetch;

    // Coalesced cart refresh. After ANY external cart mutation we re-fetch
    // /cart.js and broadcast `cartmax:cart-changed` with the latest state.
    // Overlapping mutations are NEVER dropped: if a refresh is already running,
    // we flag a trailing one so the FINAL cart is always dispatched. (The old
    // single-flight `_cartmaxFetching` guard SKIPPED any cart op that overlapped
    // an in-flight refetch — on busy stores with multiple apps + a theme that
    // fires several cart calls per add, that silently swallowed the first add,
    // so the drawer didn't open and the progress bar didn't update until the
    // next interaction.)
    var _refreshing = false;
    var _refreshQueued = false;
    function refreshCart(srcUrl) {
      if (_refreshing) { _refreshQueued = true; return; }
      _refreshing = true;
      originalFetch.call(window, '/cart.js')
        .then(function(r) { return r.json(); })
        .then(function(cart) {
          window.dispatchEvent(new CustomEvent('cartmax:cart-changed', {
            detail: { source: 'intercept', url: srcUrl, cart: cart }
          }));
        })
        .catch(function(err) { console.error('[CartMax] cart refresh failed:', err); })
        .finally(function() {
          _refreshing = false;
          if (_refreshQueued) { _refreshQueued = false; refreshCart(srcUrl); }
        });
    }

    // Patch window.fetch — observe external cart mutations, then refresh.
    window.fetch = function() {
      var url = extractUrl(arguments[0]);
      var ret = originalFetch.apply(this, arguments);
      if (!window.__cartmaxInternal && isCartEndpoint(url)) {
        ret.then(function() { refreshCart(url); }).catch(function() {});
      }
      return ret;
    };

    // Patch XMLHttpRequest — same coalesced refresh on load.
    var originalXHROpen = XMLHttpRequest.prototype.open;
    var originalXHRSend = XMLHttpRequest.prototype.send;

    XMLHttpRequest.prototype.open = function(method, url) {
      this._cartmaxUrl = url;
      return originalXHROpen.apply(this, arguments);
    };

    XMLHttpRequest.prototype.send = function() {
      var xhr = this;
      if (xhr._cartmaxUrl && isCartEndpoint(xhr._cartmaxUrl) && !window.__cartmaxInternal) {
        xhr.addEventListener('load', function() { refreshCart(xhr._cartmaxUrl); });
      }
      return originalXHRSend.apply(this, arguments);
    };

    // Queue events until Preact mounts — prevents race condition
    window.__cartmaxQueue = [];
    window.addEventListener('cartmax:cart-changed', function(e) {
      if (!window.__cartmaxReady) {
        window.__cartmaxQueue.push(e);
      }
    });

    // ── Early cart-icon click interception ────────────────────
    // This runs inline at page parse — BEFORE the deferred cartmax.js bundle
    // and before the host theme registers its own click handlers. Capturing
    // here is what prevents the native drawer from ever opening (the cause of
    // the "black old drawer flashes then cartx opens" layout shift). If the
    // bundle is already mounted we open immediately; otherwise we record the
    // intent and Preact opens on mount. Keep this selector list in sync with
    // CART_ICON_SELECTORS in CartDrawer.jsx.
    var CART_ICON_SELECTORS = [
      'a[href="/cart"]',
      'a[href="/cart/"]',
      'a[href^="/cart?"]',
      '[data-cart-icon]',
      '[data-cart-trigger]',
      '[data-cart-link]',
      '#cart-icon-bubble',
      '#cart-bubble',
      '#CartBubble',
      'cart-icon-bubble',
      '[aria-controls*="cart-drawer"]',
      '[aria-controls*="CartDrawer"]',
      '[aria-controls*="Cart-drawer"]',
      'cart-drawer-component > button'
    ].join(', ');

    window.__cartmaxOpenIntent = false;
    window.__cartmaxTrigger = null;

    document.addEventListener('click', function(e) {
      var link = e.target.closest && e.target.closest(CART_ICON_SELECTORS);
      if (!link) return;
      e.preventDefault();
      e.stopPropagation();
      if (typeof e.stopImmediatePropagation === 'function') {
        e.stopImmediatePropagation();
      }
      window.__cartmaxTrigger = link;
      if (window.__cartmaxReady && window.cartx && typeof window.cartx.open === 'function') {
        window.cartx.open();
      } else {
        // Bundle not mounted yet — Preact will honor this on mount.
        window.__cartmaxOpenIntent = true;
      }
    }, true);

    console.log('[CartMax] Fetch + click interception installed');
  })();
</script>

{{ 'cartmax.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cartmax.js' | asset_url }}" defer></script>
<!-- cache-bust: v2 -->
{%- endunless -%}

{% schema %}
{
  "name": "cartx Drawer",
  "target": "body",
  "settings": []
}
{% endschema %}
